    "interval_minutes": 60,
    "temporal_policy_version": "visible_supports_hourly_v2",
    "formula_version": "deterministic_environment_components_v2",
    "risk_level_policy": "c_equal_width_floor_v1",
    "hard_mask_policy": "land_sea_mask_threshold_v2",
