    "components": [
      {"component_id": "ice_concentration", "weight": 0.24, "transform": "identity", "lower": 0.0, "upper": 1.0},
      {"component_id": "ice_thickness", "weight": 0.14, "transform": "identity", "lower": 0.0, "upper": 3.0},
      {"component_id": "ice_type", "weight": 0.05, "transform": "identity", "lower": 0.0, "upper": 4.0},
      {"component_id": "ice_edge", "weight": 0.02, "transform": "identity", "lower": 0.0, "upper": 1.0},
      {"component_id": "ice_drift_speed", "weight": 0.06, "transform": "vector_magnitude", "lower": 0.0, "upper": 1.5},
      {"component_id": "wave_height", "weight": 0.13, "transform": "identity", "lower": 0.0, "upper": 8.0},
      {"component_id": "ocean_current_speed", "weight": 0.07, "transform": "vector_magnitude", "lower": 0.0, "upper": 2.0},
      {"component_id": "wind_speed", "weight": 0.1, "transform": "vector_magnitude", "lower": 0.0, "upper": 30.0},
      {"component_id": "freezing_deficit", "weight": 0.05, "transform": "inverse_linear", "lower": 243.15, "upper": 273.15},
      {"component_id": "visibility_deficit", "weight": 0.1, "transform": "inverse_linear", "lower": 0.0, "upper": 10000.0},
      {"component_id": "water_level_magnitude", "weight": 0.04, "transform": "absolute", "lower": 0.0, "upper": 3.0}
